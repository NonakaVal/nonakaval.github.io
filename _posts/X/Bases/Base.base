filters:
  and:
    - '!file.inFolder("+  Não Postado")'
    - '!file.inFolder("X")'
views:
  - type: table
    name: Tabela
    groupBy:
      property: file.folder
      direction: DESC
    order:
      - date
      - title
      - description
      - tags
      - image
      - categories
      - author
      - file.name
    sort:
      - property: date
        direction: DESC
    columnSize:
      note.date: 193
      note.title: 294
      note.description: 282
      note.tags: 443
      note.image: 381
  - type: table
    name: Templates
